{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Flashwright wizard window. External pages are opened from Rust, not by the webview.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "allow-engine-snapshot",
    "allow-scan",
    "allow-select-device",
    "allow-continue-from-connect",
    "allow-set-choice",
    "allow-continue-from-choose",
    "allow-open-firmware",
    "allow-build-plan",
    "allow-dry-run",
    "allow-confirm-and-run",
    "allow-back",
    "allow-open-external",
    "allow-recovery-plan",
    "allow-pick-package"
  ]
}
